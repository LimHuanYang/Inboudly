# ============================================
# INBOUDLY — ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to `.env` and fill in your values.
# AI provider keys are NOT in here — see BYOK note below.

NODE_ENV=development

# ----- Database (Supabase / PostgreSQL) -----
# Use the *Transaction pooler* string from Supabase Connect modal (port 6543).
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Use the *Session pooler* string from Supabase Connect modal (port 5432) for migrations.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ----- Supabase Auth + Storage -----
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ----- Redis (Upstash) -----
# Required for scheduled posts + repurpose worker queues.
REDIS_URL="redis://default:YOUR-PASSWORD@YOUR-HOST.upstash.io:6379"

# ============================================
# AI PROVIDER KEYS — *** BYOK MODEL ***
# ============================================
# Inboudly does NOT store AI keys in this file. Customers (workspace owners)
# add their own keys via the Settings → AI Providers UI. Each key is encrypted
# with the ENCRYPTION_KEY below before being stored in the database.
#
# Supported providers (configured per workspace, not here):
#   - Google Gemini      (free tier covers text gen)
#   - OpenAI             (image gen + Whisper + embeddings)
#   - Anthropic          (highest-quality text + repurpose clip selection)
#   - Runway / Kling     (Phase 2: video generation)
#   - ElevenLabs / Suno  (Phase 3: voice + music)
#
# Why: customers pay their AI providers directly. No subsidy, no surprise bills
# on Inboudly's side, simpler platform pricing.

# ----- Master key for encrypting user-provided AI keys -----
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Treat like a password. If lost, all user-encrypted keys become unrecoverable
# and users will have to re-enter them in Settings.
ENCRYPTION_KEY="generate-a-strong-random-64-char-string-here"

# ----- Vector DB (Pinecone) — platform-level, not per-workspace -----
# We pay for one Pinecone index shared across all workspaces (segmented by
# namespace). This is a platform infra cost, not a per-user one.
PINECONE_API_KEY=""
PINECONE_INDEX="inboudly-brand-voices"

# ----- Object Storage (Cloudflare R2) — platform-level -----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="inboudly-media"
R2_PUBLIC_URL="https://media.inboudly.com"

# ----- Social Platform OAuth (platform-level) -----
# These are the Inboudly app's OAuth credentials with each platform.
# Customers connect their own social accounts via our OAuth flow — no per-user keys.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
REDNOTE_API_KEY=""
# YouTube = Google OAuth (Google Cloud project → YouTube Data API v3 → OAuth Web client).
# Authorized redirect URI: {NEXT_PUBLIC_API_URL}/api/v1/oauth/youtube/callback
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ----- App URLs + ports -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3002"
API_PORT=3002
WEB_PORT=3000

# ----- Internal Auth -----
JWT_SECRET="change-this-to-a-strong-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
