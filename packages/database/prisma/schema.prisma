// Inboudly Database Schema
// Multi-tenant SaaS for AI-native social media management
// Tenant isolation enforced via Row-Level Security policies in Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// TENANTS & USERS
// ============================================================

enum PlanTier {
  STARTER
  PRO
  AGENCY
  WHITE_LABEL
  ENTERPRISE
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  APPROVER
  VIEWER
  CLIENT
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  plan          PlanTier @default(STARTER)
  customDomain  String?  @unique
  branding      Json?    // { logoUrl, primaryColor, secondaryColor, accentColor, fontFamily }
  billingEmail  String?
  stripeCustomerId String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspaces    Workspace[]
  subscriptions Subscription[]
  usageRecords  UsageRecord[]
  aiCredits     AiCreditBalance?
  auditLogs     AuditLog[]

  @@index([slug])
  @@index([customDomain])
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  fullName      String?
  avatarUrl     String?
  // Supabase auth user id — for linking the local profile to the auth row
  supabaseUserId String? @unique
  emailVerified DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   WorkspaceMember[]
  posts         Post[]            @relation("PostsCreatedBy")
  approvals     ApprovalStep[]
  comments      InternalComment[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
}

model Workspace {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  timezone    String   @default("UTC")
  locale      String   @default("en")
  currency    String   @default("USD") // ISO 4217 — drives money displays + AI RPM estimates
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members           WorkspaceMember[]
  socialAccounts    SocialAccount[]
  posts             Post[]
  mediaAssets       MediaAsset[]
  brandKits         BrandKit[]
  brandVoices       BrandVoice[]
  competitors       Competitor[]
  trends            Trend[]
  nicheAnalyses     NicheAnalysis[]
  videoProjects     VideoProject[]
  kolCampaigns      KolCampaign[]
  agentRuns         AgentRun[]
  approvalWorkflows ApprovalWorkflow[]
  aiCredentials     WorkspaceAiCredentials?

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/// BYOK (Bring Your Own Key) — each workspace stores its own AI provider API
/// keys, encrypted at rest with the platform's master ENCRYPTION_KEY.
/// Users pay their AI provider directly; Inboudly never touches their bill.
model WorkspaceAiCredentials {
  id            String   @id @default(cuid())
  workspaceId   String   @unique
  // Each *Key field stores the AES-256-GCM encrypted ciphertext.
  // Plaintext format: "<iv>:<authTag>:<ciphertext>" (all hex-encoded).
  geminiKey     String?  @db.Text
  openaiKey     String?  @db.Text
  anthropicKey  String?  @db.Text
  runwayKey     String?  @db.Text
  klingKey      String?  @db.Text
  elevenLabsKey String?  @db.Text
  sunoKey       String?  @db.Text
  pineconeKey   String?  @db.Text
  // Optional model overrides — when set, the service uses this model instead
  // of the platform default (e.g. claude-haiku-4-5 for cheaper, gemini-2.5-pro
  // for better quality). Plain text — model names aren't secrets.
  // Task split: anthropicModel + geminiModel = TEXT (captions); openaiModel +
  // geminiImageModel = IMAGE. Gemini does both, so it needs two model fields.
  geminiModel      String? // Gemini TEXT model (captions)
  geminiImageModel String? // Gemini IMAGE model (image gen)
  openaiModel      String? // OpenAI IMAGE model
  anthropicModel   String? // Claude TEXT model (captions)
  // Hint for the controller when both Gemini and OpenAI/Anthropic are set.
  // null = auto-select (Anthropic > Gemini for text, OpenAI > Gemini for image).
  preferredTextProvider  String?  // 'claude' | 'gemini'
  preferredImageProvider String?  // 'openai' | 'gemini'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        UserRole @default(EDITOR)
  invitedAt   DateTime @default(now())
  acceptedAt  DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ============================================================
// SOCIAL ACCOUNTS
// ============================================================

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  REDNOTE
  FACEBOOK
  LINKEDIN
  YOUTUBE
  X
  THREADS
  LEMON8
  PINTEREST
}

enum AccountStatus {
  ACTIVE
  DISCONNECTED
  EXPIRED
  ERROR
  PENDING_REAUTH
}

model SocialAccount {
  id              String         @id @default(cuid())
  workspaceId     String
  platform        SocialPlatform
  platformUserId  String         // Account ID on the platform
  handle          String         // @username
  displayName     String?
  avatarUrl       String?
  status          AccountStatus  @default(ACTIVE)
  // Encrypted at rest by application layer
  accessToken     String         @db.Text
  refreshToken    String?        @db.Text
  tokenExpiresAt  DateTime?
  scopes          String[]       @default([])
  meta            Json?          // platform-specific data (business account info, etc.)
  lastSyncedAt    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postPublications PostPublication[]
  comments        Comment[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([workspaceId, platform, platformUserId])
  @@index([workspaceId, platform])
  @@index([status])
}

// ============================================================
// BRAND KIT & BRAND VOICE
// ============================================================

model BrandKit {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String
  primaryColor    String   @default("#000000")
  secondaryColor  String?
  accentColor     String?
  fontFamily      String?
  logoUrl         String?
  logoLightUrl    String?
  logoDarkUrl     String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model BrandVoice {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  // Style guide
  toneTags      String[] @default([])    // ["casual", "witty", "professional"]
  perspective   String?                  // "we", "I", "brand-name"
  emojiUsage    String?                  // "none", "minimal", "frequent"
  glossary      Json?                    // { brandTerms: [...], productNames: [...] }
  bannedWords   String[] @default([])
  styleNotes    String?  @db.Text
  // Vector DB reference
  embeddingNamespace String  // Pinecone namespace for this brand voice's training data
  trainedOnPostCount Int     @default(0)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts         Post[]

  @@index([workspaceId])
}

// ============================================================
// MEDIA LIBRARY
// ============================================================

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  GIF
}

enum MediaSource {
  UPLOAD
  AI_GENERATED
  REPURPOSED
  STOCK
}

model MediaAsset {
  id            String      @id @default(cuid())
  workspaceId   String
  type          MediaType
  source        MediaSource @default(UPLOAD)
  url           String      // R2 public URL
  thumbnailUrl  String?
  filename      String
  mimeType      String
  sizeBytes     BigInt
  width         Int?
  height        Int?
  durationSec   Float?
  // For AI-generated
  aiPrompt      String?     @db.Text
  aiModel       String?     // "gpt-image-1", "flux-pro", "runway-gen3", etc.
  aiCostUsd     Decimal?    @db.Decimal(10, 6)
  // Repurposed-source
  parentMediaId String?
  parent        MediaAsset? @relation("RepurposedFrom", fields: [parentMediaId], references: [id])
  derivatives   MediaAsset[] @relation("RepurposedFrom")
  // Metadata
  altText       String?
  tags          String[]    @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postMedia     PostMedia[]

  @@index([workspaceId, type])
  @@index([workspaceId, source])
  @@index([parentMediaId])
}

// ============================================================
// POSTS, VARIANTS, PUBLICATIONS
// ============================================================

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

model Post {
  id            String     @id @default(cuid())
  workspaceId   String
  createdById   String
  brandVoiceId  String?
  title         String?    // internal name
  status        PostStatus @default(DRAFT)
  scheduledFor  DateTime?
  publishedAt   DateTime?
  campaignTag   String?    // optional grouping
  notes         String?    @db.Text
  // Pre-publish intelligence
  viralityScore Int?       // 0-100
  algorithmCoachReport Json? // per-platform coaching output
  multimodalCoherenceScore Int? // 0-100
  // Approval
  approvalRequired Boolean @default(false)
  lockedAfterApproval Boolean @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User             @relation("PostsCreatedBy", fields: [createdById], references: [id])
  brandVoice    BrandVoice?      @relation(fields: [brandVoiceId], references: [id])
  variants      PostVariant[]
  approvalWorkflow ApprovalWorkflow?
  internalComments InternalComment[]
  scheduledJobs ScheduledJob[]

  @@index([workspaceId, status])
  @@index([scheduledFor])
  @@index([createdById])
}

model PostVariant {
  id          String         @id @default(cuid())
  postId      String
  platform    SocialPlatform
  caption     String         @db.Text
  language    String         @default("en") // "en", "zh-CN", etc.
  hashtags    String[]       @default([])
  mentions    String[]       @default([])
  // Platform-specific fields stored as JSON
  platformOptions Json?      // e.g., TikTok privacy, Instagram alt text, RedNote topic, etc.
  // Pre-publish per-platform score
  platformScore Int?         // 0-100
  coachingNotes Json?        // platform-specific tips for THIS variant
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  post        Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  media       PostMedia[]
  publications PostPublication[]

  @@unique([postId, platform])
  @@index([postId])
}

model PostMedia {
  id            String   @id @default(cuid())
  postVariantId String
  mediaAssetId  String
  order         Int      @default(0)

  postVariant   PostVariant @relation(fields: [postVariantId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset  @relation(fields: [mediaAssetId], references: [id])

  @@unique([postVariantId, order])
  @@index([postVariantId])
  @@index([mediaAssetId])
}

enum PublicationStatus {
  PENDING
  PUBLISHING
  SUCCESS
  FAILED
  RETRY_SCHEDULED
}

model PostPublication {
  id              String            @id @default(cuid())
  postVariantId   String
  socialAccountId String
  status          PublicationStatus @default(PENDING)
  platformPostId  String?           // The ID returned by the platform
  platformPostUrl String?
  publishedAt     DateTime?
  errorMessage    String?           @db.Text
  retryCount      Int               @default(0)
  nextRetryAt     DateTime?

  postVariant     PostVariant       @relation(fields: [postVariantId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount     @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postVariantId, socialAccountId])
  @@index([status])
  @@index([nextRetryAt])
}

// ============================================================
// SCHEDULER & QUEUE TRACKING
// ============================================================

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model ScheduledJob {
  id          String    @id @default(cuid())
  postId      String?
  jobType     String    // "publish", "analytics_pull", "trend_scan", etc.
  bullJobId   String?   // BullMQ job id
  scheduledFor DateTime
  status      JobStatus @default(QUEUED)
  payload     Json?
  result      Json?
  errorMessage String?  @db.Text
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  post        Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, status])
  @@index([postId])
}

// ============================================================
// APPROVAL WORKFLOW
// ============================================================

enum ApprovalMode {
  NONE
  OPTIONAL
  REQUIRED
  MULTI_LEVEL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  CANCELLED
}

model ApprovalWorkflow {
  id            String         @id @default(cuid())
  postId        String         @unique
  workspaceId   String
  mode          ApprovalMode   @default(REQUIRED)
  currentStep   Int            @default(0)
  status        ApprovalStatus @default(PENDING)
  shareableToken String?       @unique // for client review without login
  shareableExpiresAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps         ApprovalStep[]

  @@index([workspaceId, status])
  @@index([shareableToken])
}

model ApprovalStep {
  id            String         @id @default(cuid())
  workflowId    String
  stepOrder     Int
  approverId    String?        // null = external client via shareable link
  approverEmail String?        // for external clients
  status        ApprovalStatus @default(PENDING)
  comment       String?        @db.Text
  decidedAt     DateTime?
  remindedAt    DateTime?
  createdAt     DateTime       @default(now())

  workflow      ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approver      User?            @relation(fields: [approverId], references: [id])

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
  @@index([approverId])
}

model InternalComment {
  id          String   @id @default(cuid())
  postId      String
  authorId    String
  body        String   @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])

  @@index([postId])
}

// ============================================================
// COMMENT INBOX (incoming comments/DMs from platforms)
// ============================================================

enum CommentIntent {
  PURCHASE_INTENT
  COMPLAINT
  QUESTION
  FAN_ENGAGEMENT
  SPAM
  UNCLASSIFIED
}

enum CommentSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MIXED
  UNANALYZED
}

enum CommentReplyStatus {
  PENDING
  REPLIED
  HIDDEN
  IGNORED
}

model Comment {
  id              String           @id @default(cuid())
  socialAccountId String
  // platform-side
  platformCommentId String         @unique
  platformPostId  String?          // which post it's on
  parentCommentId String?          // for threaded replies
  authorHandle    String
  authorAvatarUrl String?
  body            String           @db.Text
  language        String?
  postedAt        DateTime
  // AI-classified
  intent          CommentIntent    @default(UNCLASSIFIED)
  sentiment       CommentSentiment @default(UNANALYZED)
  intentConfidence Float?
  // status
  replyStatus     CommentReplyStatus @default(PENDING)
  hiddenAt        DateTime?
  assignedToId    String?
  // metadata
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  socialAccount   SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  replies         CommentReply[]

  @@index([socialAccountId, replyStatus])
  @@index([intent])
  @@index([sentiment])
  @@index([postedAt])
}

model CommentReply {
  id            String   @id @default(cuid())
  commentId     String
  body          String   @db.Text
  generatedByAi Boolean  @default(false)
  aiModel       String?
  sentAt        DateTime?
  sentByUserId  String?
  platformReplyId String?
  createdAt     DateTime @default(now())

  comment       Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

// ============================================================
// ANALYTICS
// ============================================================

model AnalyticsSnapshot {
  id              String         @id @default(cuid())
  socialAccountId String
  capturedAt      DateTime       @default(now())
  followerCount   Int?
  followingCount  Int?
  postCount       Int?
  reach           Int?
  impressions     Int?
  engagementRate  Decimal?       @db.Decimal(6, 4)
  // platform-specific extra metrics stored as JSON
  extra           Json?

  socialAccount   SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, capturedAt])
}

// Per-publication metrics (likes/comments/shares/saves)
model PublicationMetrics {
  id              String   @id @default(cuid())
  publicationId   String   // PostPublication.id
  capturedAt      DateTime @default(now())
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  reach           Int?
  impressions     Int?
  videoViews      Int?
  averageWatchSec Float?
  clickThroughs   Int?
  extra           Json?

  @@index([publicationId, capturedAt])
}

// ============================================================
// COMPETITOR & TREND (Phase 2 — schema in place from day 1)
// ============================================================

model Competitor {
  id              String         @id @default(cuid())
  workspaceId     String
  platform        SocialPlatform
  handle          String
  displayName     String?
  avatarUrl       String?
  trackedSince    DateTime       @default(now())
  notes           String?        @db.Text

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots       CompetitorSnapshot[]

  @@unique([workspaceId, platform, handle])
  @@index([workspaceId])
}

model CompetitorSnapshot {
  id            String   @id @default(cuid())
  competitorId  String
  capturedAt    DateTime @default(now())
  followerCount Int?
  postCount     Int?
  engagementRate Decimal? @db.Decimal(6, 4)
  topPostsJson  Json?    // top 5 posts at this snapshot
  extra         Json?

  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, capturedAt])
}

model TrendSignal {
  id            String         @id @default(cuid())
  platform      SocialPlatform
  signalType    String         // "hashtag", "sound", "topic", "format"
  signalValue   String         // the actual hashtag/sound id/topic
  niche         String?
  velocity      Decimal        @db.Decimal(10, 4) // acceleration rate
  scoredAt      DateTime       @default(now())
  expiresAt     DateTime?
  meta          Json?

  @@index([platform, signalType, scoredAt])
  @@index([niche])
}

// Trend Radar (Phase 2A.3) — curated, AI-enriched, user-facing trends.
// Distinct from TrendSignal which is the low-level raw signal store
// (machine-detected hashtags/sounds). A Trend has a topic, description,
// suggested angles, and is dismissable per workspace.
model Trend {
  id              String          @id @default(cuid())
  workspaceId     String
  platform        SocialPlatform
  topic           String          // "5-day fast challenge"
  category        String          // fitness, lifestyle, tech, beauty, food, finance, education
  description     String          @db.Text  // 1-3 sentences explaining what's trending
  velocity        TrendVelocity   @default(RISING)
  // 0-100, decays each day. <30 = stale, hidden from default list.
  freshnessScore  Int             @default(100)
  // Hypothetical engagement potential if you posted today
  estimatedReach  Int?
  suggestedAngles String[]        // 3-5 angles a brand could take
  hashtags        String[]
  exampleHandles  String[]        // who's already winning on this trend
  source          TrendSource     @default(AI_GENERATED)
  detectedAt      DateTime        @default(now())
  expiresAt       DateTime        // ~7 days TTL
  isDismissed     Boolean         @default(false)
  metadata        Json?

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  videoProjects   VideoProject[]

  @@index([workspaceId, platform, freshnessScore])
  @@index([workspaceId, isDismissed, expiresAt])
}

enum TrendVelocity {
  BREAKOUT     // brand new, exploding right now
  RISING       // steady growth, getting bigger
  SUSTAINED    // long-running, still relevant
  DECLINING    // past peak, fading
}

enum TrendSource {
  AI_GENERATED  // generated via BYOK AI provider
  API_SCRAPER   // future: real trend APIs (TrendsAPI, RisingWave, etc.)
  MANUAL        // user added it
}

// Niche Intelligence (Phase 2A.4) — cached AI analysis of a niche's
// monetization potential, market health, and adjacent opportunities.
// Cache key is (workspaceId, niche, platform). 7-day TTL via analyzedAt.
model NicheAnalysis {
  id                     String         @id @default(cuid())
  workspaceId            String
  niche                  String         // free-text e.g. "vegan baking", "indie hacker tools"
  platform               SocialPlatform?  // null = cross-platform analysis

  // RPM (revenue per 1000 views) — estimated, ranges by source.
  // `currency` records which ISO 4217 currency the figures are in (the
  // workspace currency at analysis time) so re-display stays consistent.
  currency               String         @default("USD")
  estimatedRpmMin        Decimal?       @db.Decimal(8, 2)
  estimatedRpmMax        Decimal?       @db.Decimal(8, 2)
  rpmBreakdownJson       Json?          // { ads, brandDeals, affiliate, products } ranges in `currency`

  // Health (0-100 scores)
  saturationScore        Int?           // higher = more saturated (worse)
  growthScore            Int?           // higher = niche growing fast (better)
  monetizationDifficulty Int?           // higher = harder to monetize (worse)
  overallScore           Int?           // composite 0-100 (higher = better opportunity)

  // AI-generated insights
  summary                String?        @db.Text  // one-paragraph executive summary
  opportunities          String[]       // 3-5 actionable opportunities
  threats                String[]       // 2-3 risks to watch
  topFormats             String[]       // best-performing content formats for this niche

  // Adjacent niches for the recommender
  adjacentNichesJson     Json?          // [{ niche, reason, monetizationDelta, audienceOverlap }]

  // Meta
  modelUsed              String?        // which BYOK model produced this
  analyzedAt             DateTime       @default(now())

  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, niche, platform])
  @@index([workspaceId, analyzedAt])
}

// ============================================================
// FACELESS VIDEO ENGINE (Phase 2B — flagship differentiator)
// ============================================================
// Pipeline (v1 = script only; v2 = + voice + video):
//   topic + niche → AI script (scenes) → ElevenLabs voice → Runway/Kling
//   video per scene → ffmpeg stitch → final MP4 in storage
// Each stage has its own status so the UI can show partial progress.

model VideoProject {
  id              String         @id @default(cuid())
  workspaceId     String
  niche           String         // preset niche slug: "motivational", "fitness", etc.
  topic           String         // user-input or trend-derived
  trendId         String?        // optional source — analytics: how many videos came from trends
  title           String?        // editable display title

  // Per-stage status. Each stage runs independently; downstream stages
  // unlock once their upstream is READY.
  scriptStatus    VideoStatus    @default(PENDING)
  voiceStatus     VideoStatus    @default(PENDING)
  videoStatus     VideoStatus    @default(PENDING)
  exportStatus    VideoStatus    @default(PENDING)

  finalUrl        String?        // URL to final MP4 (set when exportStatus=READY)
  thumbnailUrl    String?        // first-frame thumb
  durationSec     Int?           // total duration sum across scenes
  modelUsed       String?        // which BYOK model generated the script
  errorMessage    String?        @db.Text

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trend           Trend?         @relation(fields: [trendId], references: [id], onDelete: SetNull)
  scenes          VideoScene[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, scriptStatus])
}

model VideoScene {
  id              String         @id @default(cuid())
  projectId       String
  order           Int            // 0-indexed position in the final video
  text            String         @db.Text  // the spoken script for this scene
  visualPrompt    String?        @db.Text  // what the visual should depict (for v2 video gen)
  durationSec     Int?           // estimated duration based on script length

  // V2 outputs — null in v1
  voiceUrl        String?        // ElevenLabs MP3 output
  videoUrl        String?        // Runway/Kling MP4 output for this scene

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project         VideoProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, order])
  @@index([projectId, order])
}

enum VideoStatus {
  PENDING       // not started
  GENERATING    // in progress
  READY         // done, output available
  FAILED        // errored out, see errorMessage
}

// ============================================================
// KOL DISCOVERY (Phase 2 — schema in place from day 1)
// ============================================================

model Kol {
  id              String         @id @default(cuid())
  platform        SocialPlatform
  platformUserId  String
  handle          String
  displayName     String?
  avatarUrl       String?
  bio             String?        @db.Text
  niche           String[]       @default([])
  language        String?
  country         String?
  followerCount   Int?
  engagementRate  Decimal?       @db.Decimal(6, 4)
  authenticityScore Int?         // 0-100
  // Behavioral analysis
  bot24x7Score    Decimal?       @db.Decimal(5, 4) // 0-1 likelihood of bot engagement pattern
  commentLanguageScore Decimal?  @db.Decimal(5, 4) // 0-1 score of generic vs. content-specific comments
  audienceOverlap Json?
  lastAnalyzedAt  DateTime?
  createdAt       DateTime       @default(now())

  campaignDeliverables KolDeliverable[]

  @@unique([platform, platformUserId])
  @@index([platform, niche])
  @@index([authenticityScore])
}

model KolCampaign {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  brief         String?  @db.Text
  budgetUsd     Decimal? @db.Decimal(12, 2)
  status        String   @default("DRAFT") // DRAFT, ACTIVE, COMPLETED, CANCELLED
  startsOn      DateTime?
  endsOn        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliverables  KolDeliverable[]

  @@index([workspaceId])
}

model KolDeliverable {
  id          String   @id @default(cuid())
  campaignId  String
  kolId       String
  status      String   @default("OUTREACH_SENT")
  agreedFee   Decimal? @db.Decimal(10, 2)
  dueDate     DateTime?
  postUrl     String?
  metricsJson Json?
  createdAt   DateTime @default(now())

  campaign    KolCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kol         Kol         @relation(fields: [kolId], references: [id])

  @@index([campaignId])
  @@index([kolId])
}

// ============================================================
// AI AGENT RUNS (Phase 2+)
// ============================================================

enum AgentType {
  CONTENT
  REPLY
  TREND_HUNTER
  KOL_OUTREACH
  CRISIS
  GROWTH
  REPURPOSE
}

enum AgentRunStatus {
  RUNNING
  AWAITING_HUMAN
  COMPLETED
  FAILED
  CANCELLED
}

model AgentRun {
  id            String         @id @default(cuid())
  workspaceId   String
  agentType     AgentType
  status        AgentRunStatus @default(RUNNING)
  goal          String         @db.Text
  config        Json?          // agent-specific config
  steps         Json?          // log of steps taken
  output        Json?
  costUsd       Decimal?       @db.Decimal(10, 6)
  startedAt     DateTime       @default(now())
  endedAt       DateTime?

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([agentType])
}

// ============================================================
// BILLING
// ============================================================

model Subscription {
  id                  String   @id @default(cuid())
  tenantId            String
  plan                PlanTier
  stripeSubscriptionId String? @unique
  status              String   // active, past_due, canceled, trialing
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model UsageRecord {
  id        String   @id @default(cuid())
  tenantId  String
  metric    String   // "posts_published", "ai_text_calls", "ai_image_calls", etc.
  quantity  Int
  period    String   // "2026-05" (year-month)
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, period])
  @@index([tenantId, period])
}

model AiCreditBalance {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  balance     Int      @default(0)
  monthlyAllowance Int @default(50000)
  resetOn     DateTime
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ============================================================
// AUDIT LOG & NOTIFICATIONS
// ============================================================

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  action      String   // "post.published", "user.invited", "approval.granted", etc.
  resourceType String?
  resourceId  String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([resourceType, resourceId])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WEBHOOK
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String?             @db.Text
  link        String?
  readAt      DateTime?
  sentAt      DateTime?
  metadata    Json?
  createdAt   DateTime            @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
