{
  "name": "inboudly",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native social media intelligence platform",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@inboudly/web --filter=@inboudly/shared --filter=@inboudly/database",
    "dev:api": "turbo dev --filter=@inboudly/api --filter=@inboudly/shared --filter=@inboudly/database",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @inboudly/database db:generate",
    "db:push": "pnpm --filter @inboudly/database db:push",
    "db:migrate": "pnpm --filter @inboudly/database db:migrate",
    "db:studio": "pnpm --filter @inboudly/database db:studio",
    "db:seed:kols": "pnpm --filter @inboudly/database db:seed:kols",
    "db:seed:competitors": "pnpm --filter @inboudly/database db:seed:competitors"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
